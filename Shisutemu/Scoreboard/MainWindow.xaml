<Window x:Class="Scoreboard.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
		xmlns:local="clr-namespace:Scoreboard"
		xmlns:beh="clr-namespace:Scoreboard.Behavior"
		mc:Ignorable="d"
		Title="MainWindow" Height="1080" Width="1920">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />

		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="0.5*" />
			<ColumnDefinition Width="0.5*" />
		</Grid.ColumnDefinitions>

		<Grid x:Name="leftColumn" Grid.Column="0" Background="White" >
			<i:Interaction.Behaviors>
				<beh:ScaleFontBehavior MaxFontSize="120" />
			</i:Interaction.Behaviors>
			<Grid.Resources>
				<Style TargetType="TextBlock" >
					<Setter Property="Margin" Value="5" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
			</Grid.Resources>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="0.5*"  />
				<ColumnDefinition Width="0.5*"  />
			</Grid.ColumnDefinitions>

			<Grid.RowDefinitions>
				<RowDefinition Height="0.144*"/>
				<RowDefinition Height="0.053*"/>
				<RowDefinition Height="0.12*" />
				<RowDefinition Height="0.12*" />
				<RowDefinition Height="0.12*" />
				<RowDefinition Height="0.1*"  />
				<RowDefinition Height="0.207*"/>
				<RowDefinition Height="0.136*"/>
			</Grid.RowDefinitions>

			<Viewbox Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" >
				<TextBlock Text="A Player with a very long Name" Background="Azure" Padding="0" Margin="5,1" />
			</Viewbox>
			<Viewbox Grid.Column="0" Grid.Row="1">
				<TextBlock Text="Shido" Background="Red" Padding="0" Margin="5,1" />
			</Viewbox>
			<Viewbox Grid.Column="0" Grid.Row="2">
				<TextBlock Text="Shido dot" Background="Red" Padding="0" Margin="5,1" />
			</Viewbox>
			<Viewbox Grid.Column="0" Grid.Row="3">
				<TextBlock  Text="Shido dot" Background="Red" Padding="0" Margin="5,1" />
			</Viewbox>
			<Viewbox Grid.Column="0" Grid.Row="4">
				<TextBlock Text="Shido dot" Background="Red" Padding="0" Margin="5,1" />
			</Viewbox>
			<Viewbox Grid.Column="0" Grid.Row="5">
				<TextBlock Text="Ippon Waza-ari text" Background="Red" Padding="0" Margin="5,1" />
			</Viewbox>
			<Viewbox Grid.Column="0" Grid.Row="6">
				<TextBlock  Text="7 segment display" Background="Red" Padding="0" Margin="5,1" />
			</Viewbox>
			<Viewbox Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="2">
				<TextBlock Text="Banner" Background="Red" Padding="0" Margin="5,1" Name="Banner" />
			</Viewbox>
			<Viewbox Grid.Column="1" Grid.Row="3">
				<TextBlock Text="TextB" HorizontalAlignment="Right" />
			</Viewbox>

		</Grid>

		<Grid x:Name="rightColumn" Grid.Column="1" Background="Blue" >
			<i:Interaction.Behaviors>
				<beh:ScaleFontBehavior MaxFontSize="120" />
			</i:Interaction.Behaviors>
			<Grid.Resources>
				<Style TargetType="TextBlock" >
					<Setter Property="Margin" Value="5" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
			</Grid.Resources>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="0.5*"  />
				<ColumnDefinition Width="0.5*"  />
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Column="0" Text="SomeLongText" />
			<TextBlock Grid.Column="1" Text="TextB" HorizontalAlignment="Right" />
		</Grid>
	</Grid>

</Window>
