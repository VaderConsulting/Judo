        <SQLTask:SqlTaskData
          SQLTask:Connection="{E3C6A6DF-370E-45F0-BA05-39CDA9609A20}"
          SQLTask:SqlStatementSource="CREATE TABLE [dbo].[Playing Order] (&#xA;[Game Index] smallint NOT NULL,&#xA;[Day] tinyint,&#xA;[MatNr] tinyint NOT NULL,&#xA;[Sequence] smallint NOT NULL,&#xA;[Event Nr] tinyint,&#xA;[Class Nr] tinyint,&#xA;[Gamenumber] tinyint,&#xA;[Weight Category] nvarchar(15),&#xA;[Type of Fight] nvarchar(50),&#xA;[Player Red] nvarchar(30),&#xA;[Player White] nvarchar(30),&#xA;[Country Red] nvarchar(max),&#xA;[Country White] nvarchar(max),&#xA;[Continent Red] tinyint,&#xA;[Continent White] tinyint,&#xA;[Next Game Winner] tinyint,&#xA;[Main Referee (ID)] int,&#xA;[Main Referee (Nr)] tinyint,&#xA;[Main Referee (Name)] nvarchar(35),&#xA;[Main Referee (Country)] nvarchar(max),&#xA;[Judge 1 (ID)] int,&#xA;[Judge 1 (Nr)] tinyint,&#xA;[Judge 1 (Name)] nvarchar(35),&#xA;[Judge 1 (Country)] -1,&#xA;[Judge 2 (ID)] int,&#xA;[Judge 2 (Nr)] tinyint,&#xA;[Judge 2 (Name)] nvarchar(35),&#xA;[Judge 2 (Country)] -1,&#xA;[Starttijd] datetime,&#xA;[Eindtijd] datetime,&#xA;[Planned] bit NOT NULL,&#xA;[PrintIt] bit NOT NULL,&#xA;[Played] bit NOT NULL,&#xA;[FinalOrder] tinyint,&#xA;[Imported] bit NOT NULL,&#xA;[_Chr__01] nvarchar(25),&#xA;[_Chr__02] nvarchar(75),&#xA;[_Chr__03] nvarchar(25),&#xA;[_Chr__04] nvarchar(75),&#xA;[_Int__01] smallint,&#xA;[_Int__02] smallint,&#xA;[_Int__03] smallint,&#xA;[_Int__04] smallint,&#xA;[_Log__01] bit NOT NULL,&#xA;[_Log__02] bit NOT NULL,&#xA;[_Date__01] datetime,&#xA;[_Date__02] datetime,&#xA;[_Sng__01] real,&#xA;[Clb_Red_Id] int,&#xA;[Clb_Whi_Id] int,&#xA;[Group Descr] -1,&#xA;[BlockNr] tinyint,&#xA;[MatChar] nvarchar(2),&#xA;[StartOfFight] datetime,&#xA;[Plr_Red_Id] int,&#xA;[Plr_Whi_Id] int,&#xA;[Status] nvarchar(10),&#xA;[RecordNr] int NOT NULL,&#xA;[DrawNr Red] smallint,&#xA;[DrawNr White] smallint,&#xA;[ShowInFightOrder] bit NOT NULL,&#xA;[BreakTime] int,&#xA;[TeamFormsPrinted] bit NOT NULL,&#xA;[TeamFormsEntered] bit NOT NULL,&#xA;[TeamCompetitionFormPrinted] bit NOT NULL,&#xA;[StartTimeStr] nvarchar(8),&#xA;[EndTimeSt